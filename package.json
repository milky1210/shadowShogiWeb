{
  "name": "shadow-shogi-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:images && tsc --noEmit && vite build",
    "start": "vite preview",
    "test": "node --experimental-strip-types --test lib/shadow-shogi.test.ts lib/shadow-shogi-ai.test.ts lib/shadow-shogi-online.test.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint components/game-app.tsx components/ui/button.tsx components/ui/dialog.tsx e2e playwright.config.ts lib/shadow-shogi.ts lib/shadow-shogi-ai.ts lib/shadow-shogi-ai.worker.ts lib/shadow-shogi-online.ts lib/firebase.ts main.tsx",
    "check:images": "node scripts/check-image-budget.mjs",
    "deploy": "npm run deploy:cloudflare",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name shadow-shogi --branch main",
    "deploy:firebase-rules": "firebase deploy --only database",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "firebase": "^12.4.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "firebase-tools": "^14.17.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
